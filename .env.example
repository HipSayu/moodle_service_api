# ==== Server ====
NODE_ENV=development
PORT=4207

# ==== Docker (chỉ dùng khi chạy bằng docker compose) ====
# Địa chỉ máy chủ mở cổng ra ngoài:
#   127.0.0.1 = chỉ truy cập từ chính máy chủ (đứng sau nginx) — mặc định, an toàn
#   0.0.0.0   = mở thẳng cho mọi máy trong mạng truy cập http://<ip-may-chu>:4207
# Service KHÔNG có đăng nhập, ai vào được cổng là gọi được mọi API.
HOST_BIND=127.0.0.1
HOST_PORT=4207

# ==== SQL Server ====
SQL_SERVER=<dia-chi-sql-server>
SQL_DATABASE=EDU_NUCE
SQL_USERNAME=<user>
SQL_PASSWORD=<password>
SQL_PORT=1433
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# ==== Moodle Web Service ====
MOODLE_URL=https://md.huce.edu.vn
MOODLE_TOKEN=<token-web-service>
MOODLE_SERVICE=<ten-external-service>

# ==== Đồng bộ tự động (scheduler) ====
# Các API nhận tenDot từ request. Scheduler không có request nên phải khai báo ở đây.
ENABLE_AUTO_SYNC=false
SYNC_TEN_DOT=HK1 2026-2027

# Domain email cho sinh vien thieu Email trong DT_SinhVien
# Email se la <MaSinhVien>@<domain>, vi du 1083471@st.huce.edu.vn
# Dau cham thua o dau domain se bi bo tu dong vi Moodle tu choi email dang @.abc.vn
STUDENT_EMAIL_DOMAIN=st.huce.edu.vn
SYNC_CRON_TIME=0 0 2 * * *
SYNC_TIMEZONE=Asia/Ho_Chi_Minh

# ==== Lịch sử chạy (MongoDB) ====
# Mỗi lần chạy tác vụ được lưu kèm chi tiết từng dòng, xem ở menu "Lịch sử chạy".
# Bỏ trống MONGODB_URI thì không lưu lịch sử (service vẫn chạy bình thường).
# Ký tự đặc biệt trong mật khẩu phải mã hóa URL: @ -> %40, : -> %3A, / -> %2F
MONGODB_URI=mongodb://<user>:<password>@<ip-mongodb>:27017/?authSource=admin
MONGODB_DB=sync_lms
# Số ngày giữ lịch sử, 0 = giữ mãi
HISTORY_RETENTION_DAYS=0

# Ghi thêm kết quả từng lần chạy ra file CSV/Excel trong logs/ (mặc định tắt, đã có lịch sử MongoDB)
EXPORT_FILES=false

# ==== Logging ====
LOG_LEVEL=info
LOG_MAX_FILES=30
LOG_MAX_SIZE=10m
